{
  "name": "@local/dsh-presence",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Presence detection from a Windows presence sensor, camera face distance, and keyboard/mouse idle time, with a greeting in a chosen session when you come back.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "presence",
    "windows"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.ps1",
    "camera.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
